# AI-BOS 前端 (Next.js) systemd 服务
# 由 deploy/install.sh 自动安装（会把 <SITE_USER>/路径/启动命令替换成实际值）。
# 手动安装：
#   1) 把 <SITE_USER>、WorkingDirectory、ExecStart 改成实际值
#   2) sudo cp deploy/aibos-web.service /etc/systemd/system/
#   3) sudo systemctl daemon-reload && sudo systemctl enable --now aibos-web

[Unit]
Description=AI-BOS Next.js frontend
After=network.target aibos-api.service

[Service]
Type=simple
User=<SITE_USER>
WorkingDirectory=<WEB_DIR>
# next start -p 3300（package.json 里 "start" 已配好端口）
ExecStart=<START_CMD>
Environment=NODE_ENV=production
Environment=PORT=3300
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
