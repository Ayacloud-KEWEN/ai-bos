# ===== AI-BOS 后端环境变量（复制为 .env 并填写）=====

# PostgreSQL 连接（与 docker-compose.yml 一致；生产请改强密码）
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5435/ai_bos_db

# 允许跨域的前端域名（逗号分隔可多个）
CORS_ORIGINS=https://your-domain.com

# 默认大模型 Provider（VPS 推荐 deepseek；本地可用 ollama）
AIBOS_DEFAULT_PROVIDER=deepseek

# 各家 API Key（有哪个填哪个；首次启动会自动播种）
DEEPSEEK_API_KEY=sk-your-deepseek-key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# QWEN_API_KEY=

# HuggingFace 镜像：国内用默认 hf-mirror；海外 VPS 建议官方源
# HF_ENDPOINT=https://huggingface.co
